{
  "name": "choubo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write src tests *.json *.ts *.js index.html",
    "security:check": "node scripts/check-sensitive-files.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@primeuix/themes": "2.0.3",
    "decimal.js": "^10.6.0",
    "luxon": "^3.7.2",
    "pinia": "^4.0.3",
    "primevue": "4.5.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  }
}
